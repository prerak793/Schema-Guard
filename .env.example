# Server (Render sets PORT automatically; use 8000 for local dev)
PORT=8000

# GitHub personal access token (repo + workflow scopes)
GITHUB_TOKEN=ghp_your_github_token_here

# OpenAI API key for GPT-4o structured code generation
OPENAI_API_KEY=sk-your_openai_api_key_here

# DataHub GMS GraphQL endpoint (e.g. http://localhost:8080/api/graphql)
DATAHUB_GMS_URL=http://localhost:8080/api/graphql

# DataHub access token (optional; leave empty for unauthenticated instances)
DATAHUB_TOKEN=

# Full name of the dbt data engineering repository (owner/repo)
DATA_REPO_NAME=your-username/data-repo
